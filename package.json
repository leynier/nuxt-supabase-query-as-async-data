{
    "name": "nuxt-supabase-query-as-async-data",
    "version": "2.0.0",
    "description": "Nuxt module for using Supabase queries as asyncData",
    "license": "MIT",
    "author": "Leynier Gutiérrez González <leynier41@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leynier/nuxt-supabase-query-as-async-data.git"
    },
    "bugs": "https://github.com/leynier/nuxt-supabase-query-as-async-data/issues",
    "homepage": "https://github.com/leynier/nuxt-supabase-query-as-async-data#readme",
    "main": "dist/module.mjs",
    "types": "dist/module.d.mts",
    "exports": {
        ".": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@11.21.0",
    "scripts": {
