    "keywords": [
        "nuxt",
        "supabase",
        "module",
        "async-data",
        "postgrest"
    ],
    "peerDependencies": {
        "@supabase/postgrest-js": "^2.0.0",
        "nuxt": "^3.0.0 || ^4.0.0"
    },
    "dependencies": {
        "@nuxt/kit": "^4.5.2"
    },
    "devDependencies": {
        "@nuxt/module-builder": "^1.0.3",
        "@supabase/postgrest-js": "^2.112.2",
        "@types/node": "^26.2.0",
        "nuxt": "^4.5.2",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
